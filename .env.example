# Path to your corporate or proxy root CA certificate in PEM format.
HFH_CA_CERT_PATH=C:\path\to\corporate-ca.pem

# Optional: Node-standard alternative to HFH_CA_CERT_PATH.
# NODE_EXTRA_CA_CERTS=C:\path\to\corporate-ca.pem

# Optional temporary local debugging fallback. Do not enable in normal use.
# HFH_ALLOW_INSECURE_SSL=false
